# 복사해서 .env 로 저장 (git에는 올라가지 않음)
# 재고 알림 이메일 받을 주소
EMAIL_TO=you@example.com
# 보내는 계정 (Gmail: 2단계 인증 켜고 "앱 비밀번호" 16자리 발급 → https://myaccount.google.com/apppasswords)
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# 네이버 메일로 보내려면 (네이버 메일 설정 > POP3/SMTP 사용 켜기)
# SMTP_HOST=smtp.naver.com
# SMTP_PORT=465
# Slack 도 받으려면
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
